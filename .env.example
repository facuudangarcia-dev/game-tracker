# =============================================================================
# Game Tracker — environment variables
# Copy this file to `.env` (same folder) and fill in the values.
# NEVER commit `.env`. Values below are local-development placeholders only.
# =============================================================================

# --- PostgreSQL (used by docker-compose.yml and by the backend) --------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=game_tracker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=game_tracker
# Separate database used by backend e2e tests (created automatically by Docker)
POSTGRES_TEST_DB=game_tracker_test

# --- Backend ------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3000
# Origin allowed by CORS (the frontend dev server)
FRONTEND_ORIGIN=http://localhost:5173

# --- Authentication -------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string
AUTH_COOKIE_NAME=gt_session
# Sliding session lifetime in days (renewed on use, at most once per day)
AUTH_SESSION_TTL_DAYS=30
# Max requests per IP per minute on each public auth endpoint
# (register, login, verify-email, resend-verification)
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Email (Resend) — backend only, NEVER exposed to the frontend --------------
# Required: email verification is mandatory. Create an API key at https://resend.com
RESEND_API_KEY=
# Sender. Without your own domain use "Game Tracker <onboarding@resend.dev>"
# (Resend then only delivers to your own Resend account address).
EMAIL_FROM=
# Where user reports (offensive avatars or usernames) are emailed (decision #87).
# Optional: without it reports are only stored in the database (table user_reports).
ADMIN_EMAIL=

# --- External game catalog (backend only, NEVER exposed to the frontend) -------
CATALOG_PROVIDER=igdb
# IGDB uses Twitch OAuth credentials: https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Deals and price tracking (backend only, NEVER exposed to the frontend) ------
# Optional: without a key the Deals page and the wishlist prices explain what's
# missing. Free key (requires an IsThereAnyDeal account and a registered app):
# https://isthereanydeal.com/apps/my/ — terms: https://docs.isthereanydeal.com/
PRICE_PROVIDER=itad
ITAD_API_KEY=
# Default country of prices (ISO 3166-1 alpha-2), used until a user chooses one
# (profile or the Deals page) and when the browser doesn't say a region. Prices
# are shown in the currency the source returns for it, never converted.
ITAD_COUNTRY=AR

# --- Steam -------------------------------------------------------------------------
# Steam Web API key: linking Steam accounts and importing their games, hours and
# achievements (decision #78). SECRET, backend only: never logged. Optional: without
# it, "Mis juegos" doesn't offer Steam. Free key (requires a Steam account):
# https://steamcommunity.com/dev/apikey — terms: https://steamcommunity.com/dev/apiterms
# Steam's login comes back to FRONTEND_ORIGIN + /api/steam/callback.
STEAM_API_KEY=

# --- Gaming news -------------------------------------------------------------------
# RSS/Atom feed URLs per interface language, separated by COMMAS (at most 20 each).
# Each user sees the outlets of their language; a language without feeds shows the
# other one's. Optional: both empty = the News page explains how to configure it.
# Review each outlet's terms before adding it; only title, a short summary, image,
# date and link are shown. Examples:
#   Spanish: https://www.eurogamer.es/feed,https://www.vidaextra.com/feedburner.xml,
#            https://vandal.elespanol.com/rss/,https://www.3djuegos.com/feedburner.xml
#   English: https://www.eurogamer.net/feed,https://www.gamesradar.com/feeds/all/,
#            https://www.pcgamer.com/rss/,https://www.gamespot.com/feeds/mashup/
NEWS_PROVIDER=rss
NEWS_RSS_FEEDS_ES=
NEWS_RSS_FEEDS_EN=

# --- Asset storage (game covers) -------------------------------------------------
# Only "local" for now; designed to switch to S3 or similar later.
ASSET_STORAGE_DRIVER=local
# Local driver: directory for stored files (relative paths resolve from backend/)
ASSET_STORAGE_LOCAL_DIR=storage

# --- Production (decision #89; the Docker image already sets these) --------------
# Port assigned by the host (Railway sets it); takes precedence over BACKEND_PORT.
# PORT=
# Built frontend served by the API itself (one service, one origin). Empty in development.
# FRONTEND_DIST_DIR=/app/frontend-dist
# "true": apply pending migrations when the app starts.
DB_MIGRATIONS_RUN=false
# Reverse proxies in front of the app (real client IP for rate limits): 0 locally, 1 on Railway.
TRUST_PROXY_HOPS=0

# --- Frontend (only variables prefixed with VITE_ reach the browser) -----------
# Base URL of the API as seen by the browser. In development, Vite proxies /api
# to the backend, so the relative path keeps cookies same-origin.
VITE_API_BASE_URL=/api
# Contact email shown in the Terms of use and the Privacy policy (decision #82).
# Required before publishing the app: privacy laws require a way to reach you.
VITE_CONTACT_EMAIL=
# Backend address used by the Vite dev-server proxy (no VITE_ prefix: never exposed to the browser)
DEV_PROXY_TARGET=http://localhost:3000
